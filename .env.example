# ============================================================
#  Playroom: server settings (optional)
#  Your account and API keys are set up from the website:
#  on first launch, a setup page walks you through it.
#  This file only holds technical settings.
#  Copy it to .env if you want to change a value.
# ============================================================

# Port the server listens on
PORT=8080
# Time zone used to split days in the activity calendar
TZ=Europe/Paris
# Automatic sync every X hours (0 = never)
SYNC_INTERVAL_HOURS=6
SYNC_ON_START=true
# "Now playing" check every X seconds (0 = disabled)
PRESENCE_INTERVAL_SECONDS=120
# true when Playroom sits behind a reverse proxy (Nginx, Caddy, Traefik) that handles HTTPS
TRUST_PROXY=false
# true = fake library to preview the site (no account, read only)
DEMO=false
# Once a day, ask GitHub whether a newer Playroom release exists (only the owner sees it)
UPDATE_CHECK=true

# --- Optional: API keys (otherwise, enter them on the website) ---
# A value saved from the website overrides the one below.
# STEAM_API_KEY=
# STEAM_ID=
# PSN_NPSSO=
# OPENXBL_API_KEY=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# XBOX_PLAYTIME_MAX_TITLES=40
# STEAM_INCLUDE_FREE_GAMES=true
# STEAM_HIDE_NEVER_PLAYED=false
